APP_NAME="Rihal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rihal_next
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=
# Stateless API (Bearer tokens from localStorage). Leave empty unless using
# cookie-based SPA auth (which would require CSRF handling on the frontend).

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rihal.app"
MAIL_FROM_NAME="${APP_NAME}"

QUEUE_CONNECTION=sync
CACHE_DRIVER=array

# Notification external dispatch seam (null = log only; options: null, smtp, twilio, bd_sms)
NOTIFICATION_SMS_DRIVER=null
NOTIFICATION_EMAIL_DRIVER=null
NOTIFICATION_SEND_RATE_LIMIT=20

# Twilio (SMS) — set when NOTIFICATION_SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Bangladesh SMS gateway — set when NOTIFICATION_SMS_DRIVER=bd_sms
# Consumed by config/services.php ['sms']['url'] and ['sms']['token']
BD_SMS_API_URL=
BD_SMS_API_KEY=
BD_SMS_SENDER_ID=

# Direct SMS gateway config used by App\Services\FinancialNotificationService
# When SMS_GATEWAY_URL is empty, SMS deliveries are marked "skipped" (safe, no crash).
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Production scheduler (Laravel task scheduler) — run once per minute:
#   * * * * * cd /path/to/laravel && php artisan schedule:run >> storage/logs/scheduler.log 2>&1
# The financial:send-overdue-notifications command is scheduled daily at 08:00.
#
# Production queue (recommended for retries/throughput) — set to redis or database
# and run a worker: php artisan queue:work --queue=notifications
QUEUE_CONNECTION=sync
